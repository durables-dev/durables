{
  // Emits AppType's declarations for web (docs/adr/0010): web reads dist-types, never api's source.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["./worker-configuration.d.ts"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-types",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "worker-configuration.d.ts"]
}
