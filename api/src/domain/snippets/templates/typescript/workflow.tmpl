import { proxyActivities } from "@temporalio/workflow";
import type * as activities from "./{{activity_module}}";
{{type_import}}

// The recommended timeout and retry policy for every Durables activity.
// Errors of the listed types are permanent and are not retried.
const { {{activity_function}} } = proxyActivities<typeof activities>({
  startToCloseTimeout: "30 seconds",
  retry: {
    initialInterval: "1 second",
    backoffCoefficient: 2,
    maximumInterval: "30 seconds",
    maximumAttempts: 5,
    nonRetryableErrorTypes: {{non_retryable_error_types}},
  },
});

export async function {{workflow_function}}({{run_params}}): Promise<{{output_type}}> {
  return await {{activity_function}}({{activity_args}});
}
