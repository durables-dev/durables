"# ── imports, merged by durables.dev ──
import asyncio
import json
import os
import urllib.error
import urllib.request
from dataclasses import dataclass

from temporalio import activity
from temporalio.exceptions import ApplicationError
# ── end imports ──


# ── durables.dev/kisasa/charge-card@1.0.0 ──
# Pinned: charge-card 1.0.0, published 2026-09-28
# Publisher: Kisasa (kisasa), Verified Publisher
# Evaluation: idempotency present (pattern-matched); compensation present (declared, durables.dev/kisasa/refund-charge); heartbeat not applicable (declared); non-retryable errors present (detected: CardDeclined)
# Read-only. To change this block, publish a new version of charge-card and resolve it again.
@dataclass
class ChargeCardInput:
    amount_cents: int
    currency: str
    card_number: str


@dataclass
class ChargeCardResult:
    charge_id: str
    status: str


def _post_charge(input: ChargeCardInput, idempotency_key: str) -> dict:
    url = os.environ["MOCK_PAYMENTS_URL"].rstrip("/") + "/charges"
    body = json.dumps(
        {
            "amount": input.amount_cents,
            "currency": input.currency,
            "card_number": input.card_number,
        }
    ).encode("utf-8")
    request = urllib.request.Request(url, data=body, method="POST")
    request.add_header("Content-Type", "application/json")
    request.add_header("Authorization", "Bearer " + os.environ["MOCK_PAYMENTS_API_KEY"])
    request.add_header("Idempotency-Key", idempotency_key)
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as error:
        if error.code == 402:
            raise ApplicationError(
                "Card declined",
                type="CardDeclined",
                non_retryable=True,
            )
        raise


@activity.defn(name="charge_card")
async def charge_card(input: ChargeCardInput) -> ChargeCardResult:
    info = activity.info()
    # The same key on every retry of this activity, so a retried charge is not charged twice.
    idempotency_key = f"{info.workflow_id}-{info.activity_id}"
    charge = await asyncio.to_thread(_post_charge, input, idempotency_key)
    return ChargeCardResult(charge_id=charge["id"], status=charge["status"])
# ── end durables.dev/kisasa/charge-card@1.0.0 ──


# ── durables.dev/kisasa/refund-charge@1.0.0 ──
