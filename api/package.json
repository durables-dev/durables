{
  "name": "@durables/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts"
    }
  },
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('../web/dist', { recursive: true })\"",
    "dev": "wrangler dev",
    "build": "npm run build:types && wrangler deploy --dry-run --outdir dist src/index.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "types": "wrangler types --env-interface CloudflareBindings",
    "types:check": "wrangler types --env-interface CloudflareBindings --check",
    "typecheck": "npm run build:types && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate:local": "wrangler d1 migrations apply durables --local"
  },
  "dependencies": {
    "@durables/schemas": "*",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "4.13.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "drizzle-kit": "^0.31.11",
    "vitest": "~4.1.11",
    "wrangler": "^4.148.0"
  }
}
