# Copy to infrastructure/.env. Every variable the stack reads, with a safe local value.
# POC-5 adds postgres and the documents volume. POC-17 adds MOCK_PAYMENTS_API_KEY.

# postgres: the database and its superuser.
POSTGRES_USER=durables
POSTGRES_PASSWORD=durables
POSTGRES_DB=durables

# api: how it reaches postgres, and where it keeps version documents (the durables-documents volume).
DATABASE_URL=postgres://durables:durables@postgres:5432/durables
DOCUMENTS_DIR=/data/documents

# web: where the Vite dev server proxies /api to.
VITE_API_TARGET=http://api:3000

# mock-payments: the one API key it accepts. The consumer exports the same value
# before the demo (testing/consumer/README.md).
MOCK_PAYMENTS_API_KEY=sk_test_durables
