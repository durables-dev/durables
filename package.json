{
  "name": "durables",
  "private": true,
  "description": "A community registry of Temporal activities. See docs/adr for how it is built.",
  "workspaces": [
    "packages/schemas",
    "api",
    "web",
    "infrastructure",
    "e2e"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build:types --workspace api && npm run build --workspace web && npm run build --workspace api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace api --workspace web --workspace infrastructure --if-present",
    "e2e": "npm run test --workspace e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tsconfig/strictest": "^2.0.8",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24"
  }
}
